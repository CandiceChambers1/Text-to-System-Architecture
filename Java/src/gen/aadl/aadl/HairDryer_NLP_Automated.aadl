	connections
		HANDHELD_HAIR_DRYER0: port this_HAIR_DRYER.IN_E-> this_USER_INTERFACE.IN_E;
		HANDHELD_HAIR_DRYER1: port this_HAIR_DRYER.IN_M-> this_USER_INTERFACE.IN_M1;
		HANDHELD_HAIR_DRYER2: port this_HAIR_DRYER.IN_E-> this_POWER_UNIT.IN_E1;
