		HAIR_DRYER9: port this_PROPULSION_UNIT.OUT_M-> this_HEATING_UNIT.IN_M;
end HAIR_DRYER.impl;

system implementation USER_INTERFACE.impl
	subcomponents
		this_HANDLE: system HANDLE.impl;
		this_BODY: system BODY.impl;
	connections
		USER_INTERFACE0: port this_USER_INTERFACE.IN_E-> this_HANDLE.IN_E;
		USER_INTERFACE1: port this_HANDLE.OUT_E-> this_USER_INTERFACE.OUT_E;
		USER_INTERFACE2: port this_USER_INTERFACE.IN_M1-> this_BODY.IN_M1;
