		HANDHELD_HAIR_DRYER5: port this_USER_INTERFACE.OUT_M2-> this_HAIR_DRYER.OUT_M;
		HANDHELD_HAIR_DRYER6: port this_USER_INTERFACE.OUT_E-> this_POWER_UNIT.IN_E2;
		HANDHELD_HAIR_DRYER7: port this_POWER_UNIT.OUT_E1-> this_PROPULSION_UNIT.IN_E;
		HANDHELD_HAIR_DRYER8: port this_POWER_UNIT.OUT_E2-> this_HEATING_UNIT.IN_E;
		HANDHELD_HAIR_DRYER9: port this_PROPULSION_UNIT.OUT_M-> this_HEATING_UNIT.IN_M;
		HANDHELD_HAIR_DRYER10: port this_USER_INTERFACE.IN_E-> this_HANDLE.IN_E;
		HANDHELD_HAIR_DRYER11: port this_HANDLE.OUT_E-> this_USER_INTERFACE.OUT_E;
		HANDHELD_HAIR_DRYER12: port this_USER_INTERFACE.IN_M1-> this_BODY.IN_M1;
		HANDHELD_HAIR_DRYER13: port this_USER_INTERFACE.IN_M2-> this_BODY.IN_M2;
		HANDHELD_HAIR_DRYER14: port this_BODY.OUT_M1-> this_USER_INTERFACE.OUT_M1;
		HANDHELD_HAIR_DRYER15: port this_BODY.OUT_M2-> this_USER_INTERFACE.OUT_M2;
		HANDHELD_HAIR_DRYER16: port this_HANDLE.IN_E-> this_POWER_BUTTON.IN_E;
		HANDHELD_HAIR_DRYER17: port this_POWER_BUTTON.OUT_E-> this_HANDLE.OUT_E;
		HANDHELD_HAIR_DRYER18: port this_BODY.IN_M1-> this_INTAKE_GRILL.IN_M;
		HANDHELD_HAIR_DRYER19: port this_INTAKE_GRILL.OUT_M-> this_BODY.OUT_M2;
		HANDHELD_HAIR_DRYER20: port this_BODY.IN_M2-> this_DISCHARGE_OPENING.IN_M;
		HANDHELD_HAIR_DRYER21: port this_DISCHARGE_OPENING.OUT_M-> this_BODY.OUT_M1;
		HANDHELD_HAIR_DRYER22: port this_POWER_UNIT.IN_E1-> this_CORD.IN_E;
		HANDHELD_HAIR_DRYER23: port this_POWER_UNIT.IN_E2-> this_POWER_SWITCH.IN_E2;
		HANDHELD_HAIR_DRYER24: port this_CORD.OUT_E-> this_POWER_SWITCH.IN_E1;
		HANDHELD_HAIR_DRYER25: port this_POWER_SWITCH.OUT_E-> this_JUNCTION_BOX.IN_E;
		HANDHELD_HAIR_DRYER26: port this_JUNCTION_BOX.OUT_E1-> this_MOTOR_WIRES.IN_E;
		HANDHELD_HAIR_DRYER27: port this_JUNCTION_BOX.OUT_E2-> this_HEATING_WIRES.IN_E;
		HANDHELD_HAIR_DRYER28: port this_MOTOR_WIRES.OUT_E-> this_POWER_UNIT.OUT_E1;
		HANDHELD_HAIR_DRYER29: port this_HEATING_WIRES.OUT_E-> this_POWER_UNIT.OUT_E2;
		HANDHELD_HAIR_DRYER30: port this_PROPULSION_UNIT.IN_E-> this_MOTOR.IN_E;
		HANDHELD_HAIR_DRYER31: port this_PROPULSION_UNIT.IN_M-> this_FAN.IN_M;
		HANDHELD_HAIR_DRYER32: port this_MOTOR.OUT_E-> this_FAN.IN_E;
		HANDHELD_HAIR_DRYER33: port this_FAN.OUT_M-> this_PROPULSION_UNIT.OUT_M;
		HANDHELD_HAIR_DRYER34: port this_FAN.OUT_E-> this_PROPULSION_UNIT.OUT_E;
		HANDHELD_HAIR_DRYER35: port this_HEATING_UNIT.IN_E-> this_HEATER_CORE.IN_E;
		HANDHELD_HAIR_DRYER36: port this_HEATING_UNIT.IN_M-> this_HEATER_CORE.IN_M;
		HANDHELD_HAIR_DRYER37: port this_HEATER_CORE.OUT_E-> this_INSULATING_SLEEVE.IN_E;
		HANDHELD_HAIR_DRYER38: port this_HEATER_CORE.OUT_M-> this_HEATING_UNIT.OUT_M;
end HANDHELD_HAIR_DRYER.impl;

