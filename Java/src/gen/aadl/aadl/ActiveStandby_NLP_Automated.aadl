package ASS_AADL
public

system ASS
end ASS;

system implementation ASS.impl
	subcomponents
		this_MONITOR: system MONITOR.impl;
		this_ACTIVE_SIDE_LOGIC: system ACTIVE_SIDE_LOGIC.impl;
		this_SIDE_DEMUX: system SIDE_DEMUX.impl;
		this_ACTIVE_STANDBY_SYSTEM: system ACTIVE_STANDBY_SYSTEM.impl;
		this_SIDE_MUX: system SIDE_MUX.impl;
		this_SUB_DEMUX: system SUB_DEMUX.impl;
		this_SIDE: system SIDE.impl;
		this_ASS_BUS: system ASS_BUS.impl;
end ASS.impl;

system implementation ASS_BUS.impl
end ASS_BUS.impl;

system implementation SUB_DEMUX.impl
end SUB_DEMUX.impl;

system implementation SIDE.impl
	subcomponents
		this_THIS_SIDE_MUX: system SIDE_MUX.impl;
		this_THIS_SUB_DEMUX: system SUB_DEMUX.impl;
		this_OTHER_SUB_DEMUX: system SUB_DEMUX.impl;
		this_OTHER_SIDE_DEMUX: system SIDE_DEMUX.impl;
		this_MON: system MONITOR.impl;
		this_ACTIVE_SIDE_LOGIC_1: system ACTIVE_SIDE_LOGIC.impl;
	connections
		SIDE0: port THIS_SIDE_SUB_SYSTEM_STATUS-> this_THIS_SUB_DEMUX.SUB_SYSTEM_STATUS;
		SIDE1: port OTHER_SIDE_SUB_SYSTEM_STATUS-> this_OTHER_SUB_DEMUX.SUB_SYSTEM_STATUS;
		SIDE2: port OTHER_SIDE_STATUS-> this_OTHER_SIDE_DEMUX.STATUS;
		SIDE3: port THIS_SIDE_FAILED-> this_THIS_SIDE_MUX.FAILED;
		SIDE4: port THIS_SIDE_FAILED-> this_ACTIVE_SIDE_LOGIC_1.THIS_SIDE_FAILED;
		SIDE5: port MANUAL_SELECTION-> this_ACTIVE_SIDE_LOGIC_1.RISE_MANUAL_SELECTION;
		SIDE6: port this_THIS_SUB_DEMUX.SUB_A_STATUS-> this_MON.THIS_SIDE_SUB_A_STATUS;
		SIDE7: port this_THIS_SUB_DEMUX.SUB_N_STATUS-> this_MON.THIS_SIDE_SUB_N_STATUS;
		SIDE8: port this_OTHER_SUB_DEMUX.SUB_A_STATUS-> this_MON.OTHER_SIDE_SUB_A_STATUS;
		SIDE9: port this_OTHER_SUB_DEMUX.SUB_N_STATUS-> this_MON.OTHER_SIDE_SUB_N_STATUS;
		SIDE10: port this_MON.THIS_SIDE_FULLY_AVAIL-> this_THIS_SIDE_MUX.THIS_SIDE_FULLY_AVAIL;
		SIDE11: port this_MON.OTHER_SIDE_FULLY_AVAIL-> this_THIS_SIDE_MUX.OTHER_SIDE_FULLY_AVAIL;
		SIDE12: port this_MON.THIS_SIDE_FULLY_AVAIL-> this_ACTIVE_SIDE_LOGIC_1.THIS_MON_THIS_SIDE_FULLY_AVAIL;
		SIDE13: port this_MON.OTHER_SIDE_FULLY_AVAIL-> this_ACTIVE_SIDE_LOGIC_1.THIS_MON_OTHER_SIDE_FULLY_AVAIL;
		SIDE14: port this_OTHER_SIDE_DEMUX.ACTIVE-> this_ACTIVE_SIDE_LOGIC_1.RISE_OTHER_SIDE_ACTIVE;
		SIDE15: port this_OTHER_SIDE_DEMUX.FAILED-> this_ACTIVE_SIDE_LOGIC_1.OTHER_SIDE_FAILED;
		SIDE16: port this_OTHER_SIDE_DEMUX.THIS_SIDE_FULLY_AVAIL-> this_ACTIVE_SIDE_LOGIC_1.OTHER_MON_THIS_SIDE_FULLY_AVAIL;
		SIDE17: port this_OTHER_SIDE_DEMUX.OTHER_SIDE_FULLY_AVAIL-> this_ACTIVE_SIDE_LOGIC_1.OTHER_MON_OTHER_SIDE_FULLY_AVAIL;
		SIDE18: port this_ACTIVE_SIDE_LOGIC_1.THIS_SIDE_ACTIVE-> this_THIS_SIDE_MUX.ACTIVE;
		SIDE19: port this_THIS_SIDE_MUX.STATUS-> THIS_SIDE_STATUS;
end SIDE.impl;

system implementation SIDE_MUX.impl
end SIDE_MUX.impl;

system implementation ACTIVE_STANDBY_SYSTEM.impl
	subcomponents
		this_BUS12: system ASS_BUS.impl;
		this_BUS21: system ASS_BUS.impl;
		this_SIDE2: system SIDE.impl;
		this_SIDE1: system SIDE.impl;
	connections
		ACTIVE_STANDBY_SYSTEM0: port MANUAL_SELECTION-> this_SIDE1.MANUAL_SELECTION;
		ACTIVE_STANDBY_SYSTEM1: port SIDE1_SUB_SYSTEM_STATUS-> this_SIDE1.THIS_SIDE_SUB_SYSTEM_STATUS;
		ACTIVE_STANDBY_SYSTEM2: port SIDE1_FAILED-> this_SIDE1.THIS_SIDE_FAILED;
		ACTIVE_STANDBY_SYSTEM3: port PRIMARY_SIDE-> this_SIDE1.PRIMARY_SIDE;
		ACTIVE_STANDBY_SYSTEM4: port MANUAL_SELECTION-> this_SIDE2.MANUAL_SELECTION;
		ACTIVE_STANDBY_SYSTEM5: port SIDE2_SUB_SYSTEM_STATUS-> this_SIDE2.THIS_SIDE_SUB_SYSTEM_STATUS;
		ACTIVE_STANDBY_SYSTEM6: port SIDE2_FAILED-> this_SIDE2.THIS_SIDE_FAILED;
		ACTIVE_STANDBY_SYSTEM7: port PRIMARY_SIDE-> this_SIDE2.PRIMARY_SIDE;
		ACTIVE_STANDBY_SYSTEM8: port this_SIDE1.THIS_SIDE_STATUS-> this_BUS12.BUS_IN;
		ACTIVE_STANDBY_SYSTEM9: port this_BUS12.BUS_OUT-> this_SIDE2.OTHER_SIDE_SUB_SYSTEM_STATUS;
		ACTIVE_STANDBY_SYSTEM10: port this_SIDE2.THIS_SIDE_STATUS-> this_BUS21.BUS_IN;
		ACTIVE_STANDBY_SYSTEM11: port this_BUS21.BUS_OUT-> this_SIDE1.OTHER_SIDE_SUB_SYSTEM_STATUS;
end ACTIVE_STANDBY_SYSTEM.impl;

system implementation MONITOR.impl
end MONITOR.impl;

system implementation SIDE_DEMUX.impl
end SIDE_DEMUX.impl;

system implementation ACTIVE_SIDE_LOGIC.impl
end ACTIVE_SIDE_LOGIC.impl;

system ASS_BUS
	features
		BUS_OUT : in out data port;
		CLK : in out data port;
		BUS_IN : in out data port;
end ASS_BUS;

system SUB_DEMUX
	features
		SUB_A_STATUS : in out data port;
		SUB_N_STATUS : in out data port;
		SUB_SYSTEM_STATUS : in out data port;
end SUB_DEMUX;

system SIDE
	features
		THIS_SIDE_STATUS : in out data port;
		CLK : in out data port;
		OTHER_SIDE_STATUS : in out data port;
		PRIMARY_SIDE : in out data port;
		THIS_SIDE_FAILED : in out data port;
		OTHER_SIDE_SUB_SYSTEM_STATUS : in out data port;
		THIS_SIDE_SUB_SYSTEM_STATUS : in out data port;
		MANUAL_SELECTION : in out data port;
end SIDE;

system SIDE_MUX
	features
		OTHER_SIDE_FULLY_AVAIL : in out data port;
		STATUS : in out data port;
		THIS_SIDE_FULLY_AVAIL : in out data port;
		ACTIVE : in out data port;
		FAILED : in out data port;
end SIDE_MUX;

system ACTIVE_STANDBY_SYSTEM
	features
		SIDE1_SUB_SYSTEM_STATUS : in out data port;
		SIDE2_SUB_SYSTEM_STATUS : in out data port;
		SIDE2_FAILED : in out data port;
		SIDE1_FAILED : in out data port;
		PRIMARY_SIDE : in out data port;
		MANUAL_SELECTION : in out data port;
end ACTIVE_STANDBY_SYSTEM;

system MONITOR
	features
		THIS_SIDE_FULLY_AVAIL : in out data port;
		OTHER_SIDE_FULLY_AVAIL : in out data port;
		OTHER_SIDE_SUB_N_STATUS : in out data port;
		OTHER_SIDE_SUB_A_STATUS : in out data port;
		THIS_SIDE_SUB_N_STATUS : in out data port;
		THIS_SIDE_SUB_A_STATUS : in out data port;
end MONITOR;

system SIDE_DEMUX
	features
		OTHER_SIDE_FULLY_AVAIL : in out data port;
		STATUS : in out data port;
		THIS_SIDE_FULLY_AVAIL : in out data port;
		ACTIVE : in out data port;
		FAILED : in out data port;
end SIDE_DEMUX;

system ACTIVE_SIDE_LOGIC
	features
		RISE_OTHER_SIDE_ACTIVE : in out data port;
		THIS_SIDE_ACTIVE : in out data port;
		OTHER_SIDE_FAILED : in out data port;
		RISE_MANUAL_SELECTION : in out data port;
		THIS_SIDE_FAILED : in out data port;
		OTHER_MON_OTHER_SIDE_FULLY_AVAIL : in out data port;
		OTHER_MON_THIS_SIDE_FULLY_AVAIL : in out data port;
		THIS_MON_OTHER_SIDE_FULLY_AVAIL : in out data port;
		THIS_MON_THIS_SIDE_FULLY_AVAIL : in out data port;
end ACTIVE_SIDE_LOGIC;

end ASS_AADL;

