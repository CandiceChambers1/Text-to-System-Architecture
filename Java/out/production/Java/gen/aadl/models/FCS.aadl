package FCS
public

system FCS_SYSTEM
end FCS_SYSTEM;



system FCS
    features
		PRIMARY_SIDE : in out data port;
		TRANSFER_SWITCH : in out data port;
end FCS;

system implementation FCS.impl
	subcomponents
		this_LEFT_SIDE: system FGS.impl;
		this_RIGHT_SIDE: system FGS.impl;
		this_LR: system FCS_BUS.impl;
		this_RL: system FCS_BUS.impl;
	connections
		FCS0: port this_LEFT_SIDE.PILOT_FLYING -> this_LR.LEFT;
		FCS1: port this_RL.LEFT -> this_LEFT_SIDE.BUS_IN;
		FCS2: port this_LR.RIGHT -> this_RIGHT_SIDE.BUS_IN;
		FCS3: port this_RIGHT_SIDE.PILOT_FLYING -> this_RL.RIGHT;
		FCS4: port this_RIGHT_SIDE.TRANSFER_SWITCH -> TRANSFER_SWITCH;
		FCS5: port this_RIGHT_SIDE.PRIMARY_SIDE -> PRIMARY_SIDE;
		FCS6: port this_LEFT_SIDE.TRANSFER_SWITCH -> TRANSFER_SWITCH;
		FCS7: port this_LEFT_SIDE.PRIMARY_SIDE -> PRIMARY_SIDE;
end FCS.impl;

system FGS
    features
		TRANSFER_SWITCH : in out data port;
		PRIMARY_SIDE : in out data port;
        PILOT_FLYING : out data port;
		BUS_IN : in data port;
        CLK : in data port;
end FGS;

system implementation FGS.impl
end FGS.impl;

system FCS_BUS
    features
		LEFT : in out data port;
		RIGHT : in out data port;
        CLK : in data port;
end FCS_BUS;

system implementation FCS_BUS.impl
end FCS_BUS.impl;

system FGS_SYSTEM
end FGS_SYSTEM;

system implementation FCS_SYSTEM.impl
    subcomponents
        this_FCS: system FCS.impl;
        
end FCS_SYSTEM.impl;

end FCS;
