package ASS_AADL
public

system ASS
end ASS;

system implementation ASS.impl
	subcomponents
		this_MONITOR: system MONITOR.impl;
		this_ACTIVE_SIDE_LOGIC: system ACTIVE_SIDE_LOGIC.impl;
		this_SIDE_DEMUX: system SIDE_DEMUX.impl;
		this_ACTIVE_STANDBY_SYSTEM: system ACTIVE_STANDBY_SYSTEM.impl;
		this_SIDE_MUX: system SIDE_MUX.impl;
		this_SUB_DEMUX: system SUB_DEMUX.impl;
		this_SIDE: system SIDE.impl;
		this_BUS: system BUS.impl;
	connections
		ASS0: port this_ACTIVE_STANDBY_SYSTEM.MANUAL_SELECTION-> this_SIDE1.MANUAL_SELECTION;
		ASS1: port this_ACTIVE_STANDBY_SYSTEM.SIDE1_SUB_SYSTEM_STATUS-> this_SIDE1.THIS_SIDE_SUB_SYSTEM_STATUS;
		ASS2: port this_ACTIVE_STANDBY_SYSTEM.SIDE1_FAILED-> this_SIDE1.THIS_SIDE_FAILED;
		ASS3: port this_ACTIVE_STANDBY_SYSTEM.PRIMARY_SIDE-> this_SIDE1.PRIMARY_SIDE;
		ASS4: port this_ACTIVE_STANDBY_SYSTEM.MANUAL_SELECTION-> this_SIDE2.MANUAL_SELECTION;
		ASS5: port this_ACTIVE_STANDBY_SYSTEM.SIDE2_SUB_SYSTEM_STATUS-> this_SIDE2.THIS_SIDE_SUB_SYSTEM_STATUS;
		ASS6: port this_ACTIVE_STANDBY_SYSTEM.SIDE2_FAILED-> this_SIDE2.THIS_SIDE_FAILED;
		ASS7: port this_ACTIVE_STANDBY_SYSTEM.PRIMARY_SIDE-> this_SIDE2.PRIMARY_SIDE;
		ASS8: port this_SIDE.THIS_SIDE_SUB_SYSTEM_STATUS-> this_THIS_SUB_DEMUX.SUB_SYSTEM_STATUS;
		ASS9: port this_SIDE.OTHER_SIDE_SUB_SYSTEM_STATUS-> this_OTHER_SUB_DEMUX.SUB_SYSTEM_STATUS;
		ASS10: port this_SIDE.OTHER_SIDE_STATUS-> this_OTHER_SIDE_DEMUX.STATUS;
		ASS11: port this_SIDE.THIS_SIDE_FAILED-> this_THIS_SIDE_MUX.FAILED;
		ASS12: port this_SIDE.THIS_SIDE_FAILED-> this_ACTIVE_SIDE_LOGIC_1.THIS_SIDE_FAILED;
		ASS13: port this_SIDE.MANUAL_SELECTION-> this_ACTIVE_SIDE_LOGIC_1.RISE_MANUAL_SELECTION;
end ASS.impl;

system implementation SIDE.impl
	subcomponents
		this_THIS_SIDE_MUX: system THIS_SIDE_MUX.impl;
		this_THIS_SUB_DEMUX: system THIS_SUB_DEMUX.impl;
		this_OTHER_SUB_DEMUX: system OTHER_SUB_DEMUX.impl;
		this_OTHER_SIDE_DEMUX: system OTHER_SIDE_DEMUX.impl;
		this_MON: system MON.impl;
		this_ACTIVE_SIDE_LOGIC_1: system ACTIVE_SIDE_LOGIC_1.impl;
	connections
		SIDE0: port this_SIDE.THIS_SIDE_SUB_SYSTEM_STATUS-> this_THIS_SUB_DEMUX.SUB_SYSTEM_STATUS;
		SIDE1: port this_SIDE.OTHER_SIDE_SUB_SYSTEM_STATUS-> this_OTHER_SUB_DEMUX.SUB_SYSTEM_STATUS;
		SIDE2: port this_SIDE.OTHER_SIDE_STATUS-> this_OTHER_SIDE_DEMUX.STATUS;
		SIDE3: port this_SIDE.THIS_SIDE_FAILED-> this_THIS_SIDE_MUX.FAILED;
		SIDE4: port this_SIDE.THIS_SIDE_FAILED-> this_ACTIVE_SIDE_LOGIC_1.THIS_SIDE_FAILED;
		SIDE5: port this_SIDE.MANUAL_SELECTION-> this_ACTIVE_SIDE_LOGIC_1.RISE_MANUAL_SELECTION;
		SIDE6: port this_THIS_SUB_DEMUX.SUB_A_STATUS-> this_MON.THIS_SIDE_SUB_A_STATUS;
		SIDE7: port this_THIS_SUB_DEMUX.SUB_N_STATUS-> this_MON.THIS_SIDE_SUB_N_STATUS;
		SIDE8: port this_OTHER_SUB_DEMUX.SUB_A_STATUS-> this_MON.OTHER_SIDE_SUB_A_STATUS;
		SIDE9: port this_OTHER_SUB_DEMUX.SUB_N_STATUS-> this_MON.OTHER_SIDE_SUB_N_STATUS;
		SIDE10: port this_MON.THIS_SIDE_FULLY_AVAIL-> this_THIS_SIDE_MUX.THIS_SIDE_FULLY_AVAIL;
		SIDE11: port this_MON.OTHER_SIDE_FULLY_AVAIL-> this_THIS_SIDE_MUX.OTHER_SIDE_FULLY_AVAIL;
		SIDE12: port this_MON.THIS_SIDE_FULLY_AVAIL-> this_ACTIVE_SIDE_LOGIC_1.THIS_MON_THIS_SIDE_FULLY_AVAIL;
		SIDE13: port this_MON.OTHER_SIDE_FULLY_AVAIL-> this_ACTIVE_SIDE_LOGIC_1.THIS_MON_OTHER_SIDE_FULLY_AVAIL;
		SIDE14: port this_OTHER_SIDE_DEMUX.ACTIVE-> this_ACTIVE_SIDE_LOGIC_1.RISE_OTHER_SIDE_ACTIVE;
		SIDE15: port this_OTHER_SIDE_DEMUX.FAILED-> this_ACTIVE_SIDE_LOGIC_1.OTHER_SIDE_FAILED;
		SIDE16: port this_OTHER_SIDE_DEMUX.THIS_SIDE_FULLY_AVAIL-> this_ACTIVE_SIDE_LOGIC_1.OTHER_MON_THIS_SIDE_FULLY_AVAIL;
		SIDE17: port this_OTHER_SIDE_DEMUX.OTHER_SIDE_FULLY_AVAIL-> this_ACTIVE_SIDE_LOGIC_1.OTHER_MON_OTHER_SIDE_FULLY_AVAIL;
		SIDE18: port this_ACTIVE_SIDE_LOGIC_1.THIS_SIDE_ACTIVE-> this_THIS_SIDE_MUX.ACTIVE;
		SIDE19: port this_THIS_SIDE_MUX.STATUS-> this_SIDE.THIS_SIDE_STATUS;
end SIDE.impl;

system implementation ACTIVE_STANDBY_SYSTEM.impl
	subcomponents
		this_BUS12: system BUS12.impl;
		this_BUS21: system BUS21.impl;
		this_SIDE2: system SIDE2.impl;
		this_SIDE1: system SIDE1.impl;
	connections
		ACTIVE_STANDBY_SYSTEM0: port this_ACTIVE_STANDBY_SYSTEM.MANUAL_SELECTION-> this_SIDE1.MANUAL_SELECTION;
		ACTIVE_STANDBY_SYSTEM1: port this_ACTIVE_STANDBY_SYSTEM.SIDE1_SUB_SYSTEM_STATUS-> this_SIDE1.THIS_SIDE_SUB_SYSTEM_STATUS;
		ACTIVE_STANDBY_SYSTEM2: port this_ACTIVE_STANDBY_SYSTEM.SIDE1_FAILED-> this_SIDE1.THIS_SIDE_FAILED;
		ACTIVE_STANDBY_SYSTEM3: port this_ACTIVE_STANDBY_SYSTEM.PRIMARY_SIDE-> this_SIDE1.PRIMARY_SIDE;
		ACTIVE_STANDBY_SYSTEM4: port this_ACTIVE_STANDBY_SYSTEM.MANUAL_SELECTION-> this_SIDE2.MANUAL_SELECTION;
		ACTIVE_STANDBY_SYSTEM5: port this_ACTIVE_STANDBY_SYSTEM.SIDE2_SUB_SYSTEM_STATUS-> this_SIDE2.THIS_SIDE_SUB_SYSTEM_STATUS;
		ACTIVE_STANDBY_SYSTEM6: port this_ACTIVE_STANDBY_SYSTEM.SIDE2_FAILED-> this_SIDE2.THIS_SIDE_FAILED;
		ACTIVE_STANDBY_SYSTEM7: port this_ACTIVE_STANDBY_SYSTEM.PRIMARY_SIDE-> this_SIDE2.PRIMARY_SIDE;
		ACTIVE_STANDBY_SYSTEM8: port this_SIDE1.THIS_SIDE_STATUS-> this_BUS12.IN;
		ACTIVE_STANDBY_SYSTEM9: port this_BUS12.OUT-> this_SIDE2.OTHER_SIDE_SUB_SYSTEM_STATUS;
		ACTIVE_STANDBY_SYSTEM10: port this_SIDE2.THIS_SIDE_STATUS-> this_BUS21.IN;
		ACTIVE_STANDBY_SYSTEM11: port this_BUS21.OUT-> this_SIDE1.OTHER_SIDE_SUB_SYSTEM_STATUS;
end ACTIVE_STANDBY_SYSTEM.impl;

system BUS
	features
		OUT : in out data port;
		CLK : in out data port;
		IN : in out data port;
end BUS;

system SUB_DEMUX
	features
		SUB_A_STATUS : in out data port;
		SUB_N_STATUS : in out data port;
		SUB_SYSTEM_STATUS : in out data port;
end SUB_DEMUX;

system SIDE
	features
		THIS_SIDE_STATUS : in out data port;
		CLK : in out data port;
		OTHER_SIDE_STATUS : in out data port;
		PRIMARY_SIDE : in out data port;
		THIS_SIDE_FAILED : in out data port;
		OTHER_SIDE_SUB_SYSTEM_STATUS : in out data port;
		THIS_SIDE_SUB_SYSTEM_STATUS : in out data port;
		MANUAL_SELECTION : in out data port;
end SIDE;

system SIDE_MUX
	features
		OTHER_SIDE_FULLY_AVAIL : in out data port;
		STATUS : in out data port;
		THIS_SIDE_FULLY_AVAIL : in out data port;
		ACTIVE : in out data port;
		FAILED : in out data port;
end SIDE_MUX;

system ACTIVE_STANDBY_SYSTEM
	features
		SIDE1_SUB_SYSTEM_STATUS : in out data port;
		SIDE2_SUB_SYSTEM_STATUS : in out data port;
		SIDE2_FAILED : in out data port;
		SIDE1_FAILED : in out data port;
		PRIMARY_SIDE : in out data port;
		MANUAL_SELECTION : in out data port;
end ACTIVE_STANDBY_SYSTEM;

system MONITOR
	features
		THIS_SIDE_FULLY_AVAIL : in out data port;
		OTHER_SIDE_FULLY_AVAIL : in out data port;
		OTHER_SIDE_SUB_N_STATUS : in out data port;
		OTHER_SIDE_SUB_A_STATUS : in out data port;
		THIS_SIDE_SUB_N_STATUS : in out data port;
		THIS_SIDE_SUB_A_STATUS : in out data port;
end MONITOR;

system SIDE_DEMUX
	features
		OTHER_SIDE_FULLY_AVAIL : in out data port;
		STATUS : in out data port;
		THIS_SIDE_FULLY_AVAIL : in out data port;
		ACTIVE : in out data port;
		FAILED : in out data port;
end SIDE_DEMUX;

system ACTIVE_SIDE_LOGIC
	features
		RISE_OTHER_SIDE_ACTIVE : in out data port;
		THIS_SIDE_ACTIVE : in out data port;
		OTHER_SIDE_FAILED : in out data port;
		RISE_MANUAL_SELECTION : in out data port;
		THIS_SIDE_FAILED : in out data port;
		OTHER_MON_OTHER_SIDE_FULLY_AVAIL : in out data port;
		OTHER_MON_THIS_SIDE_FULLY_AVAIL : in out data port;
		THIS_MON_OTHER_SIDE_FULLY_AVAIL : in out data port;
		THIS_MON_THIS_SIDE_FULLY_AVAIL : in out data port;
end ACTIVE_SIDE_LOGIC;

